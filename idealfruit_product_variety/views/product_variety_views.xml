<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_variety_tree" model="ir.ui.view">
        <field name="name">product.variety.tree</field>
        <field name="model">product.variety</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" string="Código"/>
                <field name="name" string="Nombre"/>
                <field name="description" string="Descripción"/>
            </tree>
        </field>
    </record>

    <record id="view_product_variety_form" model="ir.ui.view">
        <field name="name">product.variety.form</field>
        <field name="model">product.variety</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code" string="Código"/>
                        <field name="name" string="Nombre"/>
                        <field name="description" string="Descripción"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_variety" model="ir.actions.act_window">
        <field name="name">Product Varieties</field>
        <field name="res_model">product.variety</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_product_variety_root" name="Variedades de Productos " parent="purchase.menu_purchase_config" sequence="10"/>

    <menuitem id="menu_product_variety" name="Variedades de Productos" parent="menu_product_variety_root" action="action_product_variety"/>
</odoo>
