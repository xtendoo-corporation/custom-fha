<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_line_form" model="ir.ui.view">
        <field name="name">purchase.order.line.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='products']/field[@name='order_line']/tree/field[@name='name']" position="after">
                <field name="product_variety_id" required="1" string="Variedad" domain="[('id', 'in', product_variety_available_ids)]"/>
                <field name="product_variety_available_ids" string="Variedades Disponibles" widget="many2many_tags" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
